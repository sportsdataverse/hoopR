## The citation year is the year of the current release; update it with each
## CRAN release (DESCRIPTION has no Date field to derive it from). Keep this in
## sync with the bibtex block in README.Rmd.
year <- 2026
note <- sprintf("R package version %s", meta$Version)

bibentry(
  bibtype = "Misc",
  header = "To cite the hoopR R package in publications, use:",
  author = c(person("Saiem", "Gilani", comment = c(ORCID = "0000-0002-7194-9067"))),
  title = "hoopR: Access Men's Basketball Play by Play Data",
  doi = "10.32614/CRAN.package.hoopR",
  publisher = "The R Foundation",
  year = year,
  note = note,
  textVersion = paste0(
    "Saiem Gilani (", year, "). hoopR: Access Men's Basketball Play by Play Data. ",
    note, ". https://doi.org/10.32614/CRAN.package.hoopR"
  )
)
